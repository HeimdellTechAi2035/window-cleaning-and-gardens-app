generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) — used at runtime by Netlify Functions.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only for migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum Role {
  ADMIN
  OPERATIVE
}

enum PaymentMethod {
  DIRECT_DEBIT
  CARD
  CASH
  BANK_TRANSFER
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  RESCHEDULED
}

enum PaymentStatus {
  UNPAID
  PENDING_DIRECT_DEBIT
  PAID
  FAILED
}

enum PaymentGateway {
  GOCARDLESS
  STRIPE
  MANUAL_CASH
}

enum SkipReason {
  WEATHER
  CUSTOMER_HOLIDAY
  ACCESS_LOCKED
  NON_PAYMENT
  OTHER
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum NotificationType {
  PRE_ARRIVAL
  JOB_COMPLETED
  INVOICE
  PAYMENT_RECEIPT
  PAYMENT_FAILED
  MANDATE_INVITE
}

enum DeletionRequestType {
  USER
  ORGANIZATION
}

enum DeletionRequestSource {
  IN_APP
  PUBLIC_WEB
}

enum DeletionRequestStatus {
  PENDING_VERIFICATION
  VERIFIED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

// ------------------------------------------------------------------
// Multi-tenant / Auth
// ------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/London")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Integration credentials (encrypted at rest by app layer). Each
  // organization brings its own Stripe/GoCardless account so that customer
  // payments go into that organization's own bank account, never a shared
  // one — this is what makes the app usable by more than one business.
  gocardlessAccessToken   String?
  gocardlessEnv           String  @default("sandbox")
  gocardlessWebhookSecret String?
  stripeSecretKey         String?
  stripeWebhookSecret     String?
  resendFromEmail         String?

  // RoundFlow's own subscription billing for this organization — entirely
  // separate from the org's own Stripe/GoCardless keys above, which are
  // for charging *their* customers. This is them paying us to use the app.
  platformStripeCustomerId     String?
  platformStripeSubscriptionId String?
  // incomplete (no checkout completed yet) | trialing | active | past_due
  // | canceled | unpaid — kept in sync from Stripe via webhook.
  subscriptionStatus           String    @default("incomplete")
  trialEndsAt                  DateTime?
  currentPeriodEnd             DateTime?

  // Marks the single, well-known Google Play reviewer/demo tenant. Set ONLY
  // by the dedicated, requireSuperAdmin()-gated reviewer-access action
  // (app/actions/reviewer-access.ts) — never through any tenant-facing form
  // or action, and never settable by an admin-supplied organizationId (that
  // action always locates the reviewer org itself by its own fixed slug,
  // it never accepts one as input). Used to: exempt this org from platform-
  // billing webhook writes (defence in depth — see the webhook handler),
  // and to flag it clearly in the platform-admin UI. Does NOT bypass the
  // subscription paywall by itself — that's done the same way any org is
  // already unlocked (subscriptionStatus = "active"), no special-cased gate
  // was added for this flag.
  isReviewerOrganisation  Boolean   @default(false)
  reviewerDemoDataResetAt DateTime?

  users     User[]
  customers Customer[]
  rounds    Round[]
  jobs      Job[]

  // Nullable / SET NULL deliberately — a deletion request must survive the
  // organization it refers to being deleted (that's the whole point of the
  // audit trail), so this can never be an onDelete: Cascade relation.
  deletionRequests AccountDeletionRequest[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(OPERATIVE)
  phone         String?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  assignedJobs Job[] @relation("AssignedWorker")
  completedBy  Job[] @relation("CompletedByWorker")

  // Same SET NULL reasoning as Organization.deletionRequests above.
  deletionRequests AccountDeletionRequest[]

  @@index([organizationId])
  @@map("users")
}

// The platform owner's own login for /admin — deliberately NOT a User row.
// There is no tenant Organization here and no self-serve signup: the only
// way one of these gets created is the secret-gated /admin-bootstrap flow
// (SUPER_ADMIN_BOOTSTRAP_SECRET) or an existing admin creating another.
// Kept fully separate from User/Organization so a platform admin never
// accidentally ends up looking at (or being confused with) a tenant's
// dashboard.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pushSubscriptions PushSubscription[]

  @@map("platform_admins")
}

// A browser Push API subscription for a platform admin's device, used to
// send a notification (e.g. "new company signed up") straight to their
// installed /admin PWA.
model PushSubscription {
  id              String        @id @default(cuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  endpoint        String        @unique
  p256dh          String
  auth            String
  createdAt       DateTime      @default(now())

  @@index([platformAdminId])
  @@map("push_subscriptions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------------------
// Customers & Properties
// ------------------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  altPhone  String?

  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostcode     String?

  preferredPaymentMethod PaymentMethod @default(CASH)

  gocardlessCustomerId         String?
  gocardlessMandateId          String?
  mandateStatus                String? // pending_submission, submitted, active, failed, cancelled
  stripeCustomerId             String?
  stripeDefaultPaymentMethodId String?

  portalToken String @unique @default(cuid())

  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties    Property[]
  transactions  Transaction[]
  notifications Notification[]

  @@index([organizationId])
  @@map("customers")
}

model Property {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  addressLine1 String
  addressLine2 String?
  city         String
  postcode     String
  latitude     Float?
  longitude    Float?

  accessNotes String?          @db.Text
  hazards     PropertyHazard[]

  // The round this property belongs to. Set automatically from the city
  // on create/edit, unless roundLocked is true — which happens once an
  // admin manually moves it via "Move to round" (e.g. when a big area
  // round like "Preston" gets split into day-sized sub-rounds), so a
  // later address edit doesn't silently snap it back.
  roundId     String?
  round       Round?  @relation(fields: [roundId], references: [id])
  roundLocked Boolean @default(false)

  propertyPhotoUrl String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  services Service[]
  jobs     Job[]

  @@index([customerId])
  @@index([roundId])
  @@map("properties")
}

enum HazardSeverity {
  LOW
  MEDIUM
  HIGH
}

model PropertyHazard {
  id         String         @id @default(cuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String // e.g. "Aggressive Dog", "Fragile Glass", "Key Code Required"
  severity   HazardSeverity @default(MEDIUM)
  createdAt  DateTime       @default(now())

  @@index([propertyId])
  @@map("property_hazards")
}

// ------------------------------------------------------------------
// Services, Rounds, Jobs
// ------------------------------------------------------------------

model Service {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  title                String // "Standard Window Clean", "Lawn Mowing & Edging"
  description          String? @db.Text
  price                Decimal @db.Decimal(10, 2)
  defaultIntervalWeeks Int     @default(4) // 0 = one-off
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([propertyId])
  @@map("services")
}

model Round {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  colorCode   String  @default("#6366f1")
  dayOfWeek   Int? // 0-6, informational default day
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs       Job[]
  properties Property[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("rounds")
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  assignedWorkerId String?
  assignedWorker   User?   @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])

  status                  JobStatus @default(SCHEDULED)
  scheduledDate           DateTime
  sequenceOrder           Int       @default(0) // manual drag-and-drop order within the day/round
  intervalWeeksAtCreation Int       @default(4) // snapshot of the interval used to schedule this job

  startedAt           DateTime?
  completedAt         DateTime?
  completedByWorkerId String?
  completedByWorker   User?     @relation("CompletedByWorker", fields: [completedByWorkerId], references: [id])

  priceCharged Decimal @db.Decimal(10, 2)

  skipReason     SkipReason?
  skipNote       String?
  carriedForward Boolean     @default(false)

  beforePhotoUrl String?
  afterPhotoUrl  String?
  workerNotes    String? @db.Text

  isPaid        Boolean       @default(false)
  paymentStatus PaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  notifications Notification[]

  @@index([organizationId, scheduledDate])
  @@index([roundId])
  @@index([propertyId])
  @@map("jobs")
}

// ------------------------------------------------------------------
// Payments
// ------------------------------------------------------------------

model Transaction {
  id         String   @id @default(cuid())
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount               Decimal        @db.Decimal(10, 2)
  currency             String         @default("GBP")
  paymentGateway       PaymentGateway
  gatewayTransactionId String?
  status               PaymentStatus  @default(PENDING_DIRECT_DEBIT)
  failureReason        String?

  invoiceNumber String? @unique
  invoicePdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([jobId])
  @@map("transactions")
}

model Notification {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])

  type              NotificationType
  channel           NotificationChannel
  recipient         String // phone number or email actually used
  subject           String?
  body              String              @db.Text
  status            String              @default("queued") // queued, sent, delivered, failed
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([customerId])
  @@map("notifications")
}

// ------------------------------------------------------------------
// Account deletion (Google Play / UK GDPR compliance)
// ------------------------------------------------------------------

// The permanent audit record that a deletion request existed and was
// handled — deliberately designed to outlive the User/Organization it
// refers to. Both relations below are onDelete: SetNull, never Cascade,
// so deleting the account this request is ABOUT can never delete the
// record that PROVES the deletion happened. Email/name fields are
// snapshotted at request time for the same reason: the live row may be
// gone or anonymised by the time anyone reads this record back.
model AccountDeletionRequest {
  id          String                @id @default(cuid())
  requestType DeletionRequestType
  source      DeletionRequestSource
  status      DeletionRequestStatus @default(PENDING_VERIFICATION)

  organizationId           String?
  organization             Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationNameSnapshot String?

  userId            String?
  user              User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmailSnapshot String?

  // The email address the request was made from/for — always kept, even
  // once the account itself is gone or anonymised.
  requesterEmail String

  // Never store the raw token — only its SHA-256 hash, checked with a
  // timing-safe comparison. Single-use (status leaves PENDING_VERIFICATION
  // the moment it's consumed) and time-limited (verificationExpiry).
  verificationTokenHash String?
  verificationExpiry    DateTime?

  requestedAt        DateTime  @default(now())
  verifiedAt         DateTime?
  processingDeadline DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?

  // Free-text notes from whoever processed it, and a short summary of what
  // was deleted vs retained (and why) — the minimum needed to prove the
  // request was handled correctly, without itself becoming a new store of
  // personal data.
  processingNotes  String? @db.Text
  retentionSummary String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("account_deletion_requests")
}

// A minimal, anonymised snapshot created ONLY when an organization
// deletion is processed — exists purely so Heimdell's own accounting
// records reconcile with what Stripe already retains under Heimdell's
// platform Stripe account. Deliberately has NO foreign keys at all (not
// even a nullable one) so it is structurally impossible for this table to
// be affected by any future deletion, and deliberately carries no tenant
// customer personal data — only the fact that an organization subscribed,
// for how long, and a reference back to Stripe's own (separately retained)
// invoice history for the actual financial detail.
model PlatformBillingRecord {
  id String @id @default(cuid())

  organizationName String
  organizationSlug String

  platformStripeCustomerId     String?
  platformStripeSubscriptionId String?
  lastSubscriptionStatus       String

  subscriptionStartedAt DateTime?
  subscriptionEndedAt   DateTime

  // Loose reference only (no FK) — for cross-referencing back to the
  // AccountDeletionRequest audit trail, never a hard dependency.
  deletionRequestId String?

  retainedUntil   DateTime
  retentionReason String   @default("UK accounting/tax record-keeping obligation (Companies Act 2006 s.388 / HMRC guidance: 6 years)")

  createdAt DateTime @default(now())

  @@map("platform_billing_records")
}

// Abuse-protection counters for the unauthenticated public deletion-request
// endpoints only (/legal/delete-account and its email-verification step).
// A fixed-window counter per (scope, key): "scope" identifies which limit
// this is (e.g. "public_deletion_submit_ip"), "key" is a keyed-HMAC hash of
// the real value (IP address or normalised email) — never the raw value
// itself. No relations to any other model, deliberately: this table is
// purely a short-lived abuse-protection signal, not personal data, and must
// never interfere with account/organization deletion in either direction.
model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
